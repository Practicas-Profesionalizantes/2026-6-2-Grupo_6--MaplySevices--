{
  "expo": {
    "name": "Maply",
    "slug": "maply-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maplyfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.maplyservices.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E50E3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maplyservices.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E50E3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@rnmapbox/maps",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Maply usa tu ubicación solo para centrar el mapa en los lugares cercanos. No se guarda ni se comparte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
