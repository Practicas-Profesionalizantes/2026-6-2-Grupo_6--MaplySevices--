# Copiar a .env y completar. No se sube al repo (agregalo a .gitignore).

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=maply_services

# Clave para firmar los JWT (mínimo 32 caracteres). Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# id_rol que se asigna a un usuario nuevo al registrarse. Correr
# "SELECT * FROM rol;" en phpMyAdmin y poner acá el id de "usuario común"
# o "registrado" (el que corresponda en tu tabla). Default: 2.
DEFAULT_ROL_ID=2

# id_rol del administrador (el que puede bloquear usuarios en /api/admin). Default: 1.
ADMIN_ROL_ID=1

# Orígenes web permitidos (separados por coma). La app nativa no lo necesita.
CORS_ORIGINS=http://localhost:8081

# Poner 1 SOLO si el backend corre detrás de un proxy (Render, Railway, nginx...).
# Sin proxy dejalo vacío: si no, cualquiera puede falsificar su IP.
TRUST_PROXY=

# Mails de "olvidé mi contraseña". Sin esto, en desarrollo el código se
# imprime en la consola del backend. Con Gmail: activá la verificación en 2
# pasos y creá una "contraseña de aplicación" (no es tu contraseña normal).
SMTP_USER=
SMTP_PASS=
