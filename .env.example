# Copiar a .env y completar. No se sube al repo (agregalo a .gitignore).

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=maply_services

# Clave para firmar los JWT. Cualquier texto largo y random sirve para desarrollo.
JWT_SECRET=cambiar_por_una_clave_larga_y_unica

PORT=3000

# id_rol que se asigna a un usuario nuevo al registrarse. Correr
# "SELECT * FROM rol;" en phpMyAdmin y poner acá el id de "usuario común"
# o "registrado" (el que corresponda en tu tabla). Default: 2.
DEFAULT_ROL_ID=2
