# Copiar este archivo a .env y completar con tus valores locales.
# .env no se sube al repo (ya está en .gitignore).

# URL base del backend de Node/Express (el que arma Felipe).
# En desarrollo local con XAMPP/Node corriendo en tu compu, suele ser:
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Token público de Mapbox (Account > Tokens en mapbox.com).
# Restringilo por dominio/bundle id desde el panel de Mapbox antes de publicar.
EXPO_PUBLIC_MAPBOX_TOKEN=
